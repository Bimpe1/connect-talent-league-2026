# Connect Talent League 2026 - Environment Variables
# Copy this file to .env.local for local testing, and add to Vercel Settings -> Environment Variables for production.

# 1. PostgreSQL Database (Vercel Postgres / Neon)
# Automatically populated if using Vercel Postgres integration:
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# 2. Email Notifications (Resend - https://resend.com)
# Free tier gives 3,000 emails/month. Sign up at resend.com, grab API key, and paste below:
RESEND_API_KEY=re_your_api_key_here

# 3. Email From Address (Optional)
# If using Resend default sandbox:
EMAIL_FROM=Connect Talent League <onboarding@resend.dev>
# Or if you verified your charity custom domain on Resend:
# EMAIL_FROM=Connect Talent League <league@connecttalent.org>
